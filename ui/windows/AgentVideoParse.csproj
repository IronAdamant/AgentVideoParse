<?xml version="1.0" encoding="utf-8"?>
<!--
  Native Windows GUI — inbox WPF / .NET Framework only.
  No NuGet PackageReference. No Python runtime.
  Double-click the built AgentVideoParse.exe (see scripts/build-windows-app.ps1).
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>AgentVideoParse</RootNamespace>
    <AssemblyName>AgentVideoParse</AssemblyName>
    <ApplicationIcon>..\..\assets\icon.ico</ApplicationIcon>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Portable build: framework-dependent on Windows 10/11 (.NET Framework 4.7.2+ is inbox) -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Product>AgentVideoParse</Product>
    <Company>AgentVideoParse</Company>
    <Description>Short debug video → ordered screenshots for AI agents (Windows)</Description>
    <Version>1.1.2</Version>
  </PropertyGroup>
  <ItemGroup>
    <!-- Explicit inbox references (no packages) -->
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xaml" />
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
  </ItemGroup>
  <ItemGroup>
    <!-- Window/title-bar icon: full plate. In-window header: flat transparent mark. -->
    <Resource Include="..\..\assets\logo-256.png">
      <Link>Assets\logo-256.png</Link>
    </Resource>
    <Resource Include="..\..\assets\logo-mark.png">
      <Link>Assets\logo-mark.png</Link>
    </Resource>
  </ItemGroup>
</Project>
