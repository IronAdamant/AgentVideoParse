<Window x:Class="AgentVideoParse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AgentVideoParse" Height="680" Width="560" MinHeight="620" MinWidth="520"
        Icon="pack://application:,,,/Assets/logo-256.png"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource PrimaryText}"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <!-- Defaults before ThemeSettings.Apply (dark product default) -->
    <SolidColorBrush x:Key="WindowBackground" Color="#1E1E20"/>
    <SolidColorBrush x:Key="PanelBackground" Color="#2C2C2E"/>
    <SolidColorBrush x:Key="PrimaryText" Color="#F5F5F7"/>
    <SolidColorBrush x:Key="SecondaryText" Color="#98989D"/>
    <SolidColorBrush x:Key="DisclaimerBackground" Color="#4A4522"/>
    <SolidColorBrush x:Key="DisclaimerBorder" Color="#7A6E35"/>
    <SolidColorBrush x:Key="DisclaimerText" Color="#F5F0D8"/>
    <SolidColorBrush x:Key="DropFill" Color="#2C2C2E"/>
    <SolidColorBrush x:Key="DropBorder" Color="#8E8E93"/>
    <SolidColorBrush x:Key="ControlBackground" Color="#3A3A3C"/>
    <SolidColorBrush x:Key="ControlBorder" Color="#545458"/>
    <SolidColorBrush x:Key="InputBackground" Color="#28282A"/>

    <Style TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="CaretBrush" Value="{DynamicResource PrimaryText}"/>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>

    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
  </Window.Resources>

  <DockPanel Margin="16">
    <!-- Footer + appearance -->
    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
        <TextBlock VerticalAlignment="Center" Margin="0,0,10,0"
                   Foreground="{DynamicResource SecondaryText}"
                   Text="Appearance"/>
        <RadioButton x:Name="ThemeDarkRadio" Content="Dark" GroupName="Appearance"
                     Margin="0,0,12,0" VerticalAlignment="Center"
                     Checked="Theme_Changed"/>
        <RadioButton x:Name="ThemeLightRadio" Content="Light" GroupName="Appearance"
                     VerticalAlignment="Center"
                     Checked="Theme_Changed"/>
      </StackPanel>
      <TextBlock x:Name="FooterText" HorizontalAlignment="Center"
                 Foreground="{DynamicResource SecondaryText}"
                 FontSize="11"/>
    </StackPanel>

    <StackPanel>
      <!-- Header: flat transparent mark (no plate / corner clip — avoids eyesore double-radius) -->
      <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
        <Image Source="pack://application:,,,/Assets/logo-mark.png"
               Stretch="Uniform" Height="48" MaxWidth="80" Margin="0,0,12,0"
               RenderOptions.BitmapScalingMode="HighQuality"
               SnapsToDevicePixels="True"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock FontSize="22" FontWeight="Bold" Text="AgentVideoParse"
                     Foreground="{DynamicResource PrimaryText}"/>
          <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource SecondaryText}"
                     Text="Short debug video → ordered screenshots for AI agents"/>
        </StackPanel>
      </StackPanel>

      <!-- Disclaimer (always visible) -->
      <Border Background="{DynamicResource DisclaimerBackground}"
              BorderBrush="{DynamicResource DisclaimerBorder}"
              BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Disclaimer (always visible)"
                     FontWeight="SemiBold" FontSize="11"
                     Foreground="{DynamicResource SecondaryText}"/>
          <TextBlock x:Name="DisclaimerText" TextWrapping="Wrap" Margin="0,6,0,0"
                     Foreground="{DynamicResource DisclaimerText}"/>
        </StackPanel>
      </Border>

      <!-- Drop zone (dashed, matches macOS) -->
      <Grid x:Name="DropZone" Height="140" AllowDrop="True" Cursor="Hand"
            Drop="DropZone_Drop" DragOver="DropZone_DragOver"
            MouseLeftButtonUp="DropZone_Click">
        <Rectangle RadiusX="12" RadiusY="12"
                   Fill="{DynamicResource DropFill}"
                   Stroke="{DynamicResource DropBorder}"
                   StrokeThickness="2"
                   StrokeDashArray="6 4"/>
        <TextBlock x:Name="DropZoneLabel"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextAlignment="Center"
                   Foreground="{DynamicResource SecondaryText}"
                   Text="Drop a video here (.mov, .mp4, …)&#x0a;or click to choose file"/>
      </Grid>

      <!-- Output folder -->
      <DockPanel Margin="0,12,0,4">
        <TextBlock VerticalAlignment="Center" Text="Output folder:" Margin="0,0,8,0"
                   Foreground="{DynamicResource PrimaryText}"/>
        <Button DockPanel.Dock="Right" Content="Change" MinWidth="80" Margin="8,0,0,0"
                Click="ChangeOut_Click"/>
        <TextBox x:Name="OutputRootBox"/>
      </DockPanel>

      <TextBlock x:Name="SamplingText" Margin="0,4,0,8" FontSize="11"
                 Foreground="{DynamicResource SecondaryText}"/>

      <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,2,0,8"
                 Foreground="{DynamicResource PrimaryText}"/>

      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <CheckBox x:Name="DebugCheck" Content="Debug logging" VerticalAlignment="Center"
                  Checked="DebugCheck_Changed" Unchecked="DebugCheck_Changed"/>
        <Button x:Name="OpenLogBtn" Content="Open debug log" MinWidth="120" Margin="12,0,8,0"
                IsEnabled="False" Click="OpenLog_Click"/>
        <Button x:Name="CopyLogBtn" Content="Copy log path" MinWidth="110" IsEnabled="False"
                Click="CopyLog_Click"/>
      </StackPanel>

      <StackPanel Orientation="Horizontal">
        <Button x:Name="RevealBtn" Content="Reveal in Explorer" MinWidth="140" Margin="0,0,8,0"
                IsEnabled="False" Click="Reveal_Click"/>
        <Button x:Name="CopyBtn" Content="Copy path" MinWidth="100" IsEnabled="False"
                Click="Copy_Click"/>
      </StackPanel>
    </StackPanel>
  </DockPanel>
</Window>
